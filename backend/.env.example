# ==============================================================================
# Food Verse AI — Backend Environment Configuration Example
# Copy this file to '.env' and populate variables for your chosen environment.
# NEVER commit your actual '.env' file containing real secrets to Git.
# ==============================================================================

# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=True

# Application Details
PROJECT_NAME="Food Verse AI API"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# CORS Configuration (JSON array or comma-separated list of allowed origins)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration (SQLite for local dev, PostgreSQL for cloud deployment)
DATABASE_URL=sqlite:///./food_verse.db

# Security & Upload Guardrails
MAX_UPLOAD_SIZE_MB=10
AI_REQUEST_TIMEOUT_SECONDS=25

# ==============================================================================
# AI Provider Selection: 'vertexai' | 'gemini' | 'mock'
# ==============================================================================
# - 'vertexai': Recommended for NASSCOM FutureSkills Generative AI with Google Cloud
# - 'gemini': Alternative using Google AI Studio Gemini Developer API key
# - 'mock': Offline deterministic testing mode (zero credentials required)
AI_PROVIDER=mock

# Model Identifier across providers (e.g. 'gemini-1.5-flash', 'gemini-1.5-pro')
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# OPTION A: Google Cloud Vertex AI (Internship Preferred)
# Required when AI_PROVIDER=vertexai
# ------------------------------------------------------------------------------
# 1. Your Google Cloud Project ID with Vertex AI API enabled (aiplatform.googleapis.com)
GCP_PROJECT_ID=your_gcp_project_id_here

# 2. Google Cloud Region where Vertex AI models are deployed
GCP_LOCATION=us-central1

# 3. Authentication for Vertex AI:
#    - If using Application Default Credentials (ADC), leave GOOGLE_APPLICATION_CREDENTIALS empty
#      and run: `gcloud auth application-default login`
#    - If using a Service Account Key JSON file, set the absolute file path here:
GOOGLE_APPLICATION_CREDENTIALS=

# ------------------------------------------------------------------------------
# OPTION B: Google AI Studio Gemini Developer API
# Required when AI_PROVIDER=gemini
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
