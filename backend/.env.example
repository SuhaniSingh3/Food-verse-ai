# Environment Mode: development | staging | production
ENVIRONMENT=development
DEBUG=True

# Application Details
PROJECT_NAME="Food Verse AI API"
VERSION="1.0.0"
API_V1_PREFIX="/api"

# CORS Configuration (JSON array or comma-separated list of allowed origins)
# For local development with Vite:
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database Configuration
DATABASE_URL=sqlite:///./food_verse.db

# AI Provider Configuration
# Set to 'mock' for local offline testing, or 'gemini' for Google Cloud Gemini API
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Security & Upload Guardrails
MAX_UPLOAD_SIZE_MB=10
